# ==========================================================================
# Cyborg Healthcare Backend — example environment config
# Copy to `.env` and fill in real values before running `npm run dev`.
# ==========================================================================

# --- Server ---------------------------------------------------------------
PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# --- Database -------------------------------------------------------------
MONGO_URI=mongodb://localhost:27017/cyborg
# Optional: separate vector DB for embeddings. Can point at the same cluster.
VECTOR_DB_URI=mongodb://localhost:27017/cyborg_vector

# --- Auth -----------------------------------------------------------------
JWT_SECRET=replace-with-a-long-random-string

# --- Email (Gmail app password) ------------------------------------------
EMAIL_USER=you@example.com
EMAIL_PASS=your-gmail-app-password

# --- Razorpay -------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- AI providers ---------------------------------------------------------
# Blood-report vision parsing + chat. Claude is the primary provider.
ANTHROPIC_API_KEY=
AI_PROVIDER=claude
CLAUDE_MODEL=claude-sonnet-4-6
ENABLE_THINKING=true
THINKING_BUDGET_TOKENS=8000
MAX_CONTEXT_MESSAGES=30

# Gemini (secondary — embeddings + fallback vision/chat)
# KEY_primary is tried first. KEY_1-6 are fallbacks on quota/rate errors.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY_primary=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=

# Perplexity (research / web-grounded queries)
PERPLEXITY_API_KEY=

# --- Cloudflare R2 (file storage) ----------------------------------------
# Used for blood-report PDFs/images and meal photos.
#
# Setup:
#   1. Create a bucket in the Cloudflare dashboard (suggested: cyborg-uploads).
#   2. Enable public access via the r2.dev subdomain
#      (Bucket > Settings > Public Access > r2.dev subdomain > Allow).
#      Copy the pub-<hash>.r2.dev URL into R2_PUBLIC_URL_BASE below.
#   3. R2 > Manage R2 API Tokens > Create API Token.
#      Scope: "Object Read & Write", bucket: cyborg-uploads (or All).
#      Paste the Access Key ID + Secret into the fields below.
#
# R2_ACCOUNT_ID is the Cloudflare account ID visible on the R2 overview page.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=cyborg-uploads
R2_PUBLIC_URL_BASE=https://pub-REPLACEME.r2.dev

# --- Report parsing tuning -----------------------------------------------
# Token budgets for Claude Vision on lab reports. Retry budget is used once
# if the primary pass is truncated.
VISION_BASE_MAX_TOKENS=32768
VISION_RETRY_MAX_TOKENS=64000

# --- Meal-image TTL (kept for backwards compat; R2 lifecycle rules do the
# real cleanup now) -------------------------------------------------------
MEAL_PENDING_TTL_MS=86400000
